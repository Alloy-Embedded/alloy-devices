{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alloy.chip.v1",
  "title": "Alloy per-chip instance file",
  "type": "object",
  "required": [
    "schema",
    "vendor",
    "family",
    "part",
    "provenance",
    "cores",
    "memories",
    "peripherals",
    "clock"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "alloy.chip.v1"
    },
    "vendor": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "part": {
      "type": "string",
      "minLength": 4
    },
    "die": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "arch"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "arch": {
            "enum": [
              "armv6m",
              "armv7m",
              "armv7em",
              "armv8m_base",
              "armv8m_main",
              "rv32imc",
              "rv32imac",
              "xtensa_lx6",
              "xtensa_lx7",
              "avr8",
              "rl78_s3"
            ]
          },
          "fpu": {
            "type": "boolean",
            "default": false
          },
          "nvic_prio_bits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      }
    },
    "memories": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "base",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "flash",
              "ram",
              "ccm",
              "eeprom"
            ]
          },
          "base": {
            "$ref": "#/$defs/hex"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "erase_size": {
            "type": "integer",
            "minimum": 1,
            "description": "Flash erase-page granularity (bytes). Optional; when present, nvm/fs regions must be a whole multiple of it."
          }
        }
      }
    },
    "peripherals": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "base"
        ],
        "additionalProperties": false,
        "properties": {
          "ip": {
            "type": "string",
            "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"
          },
          "base": {
            "$ref": "#/$defs/hex"
          },
          "gate": {
            "type": "object",
            "required": [
              "peripheral",
              "register",
              "bit"
            ],
            "additionalProperties": false,
            "properties": {
              "peripheral": {
                "type": "string"
              },
              "register": {
                "type": "string"
              },
              "bit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "style": {
                "enum": [
                  "rmw",
                  "write_set",
                  "reset_release"
                ],
                "default": "rmw",
                "description": "rmw: set the bit read-modify-write (ST *ENR). write_set: write-only set register \u2014 write the mask directly (Microchip PMC_PCERx). reset_release: CLEAR the bit to release the block from reset, then poll the same bit in done_register (RP2040 RESETS)."
              },
              "done_register": {
                "type": "string",
                "description": "reset_release only: register (same peripheral) whose bit must read 1 after release (RP2040 RESET_DONE)."
              }
            }
          },
          "irq": {
            "type": "string"
          },
          "irq_lines": {
            "type": "array",
            "description": "For a controller whose numbered lines are GROUPED onto several NVIC vectors rather than one (STM32 EXTI: lines 0-1 -> EXTI0_1, 2-3 -> EXTI2_3, 4-15 -> EXTI4_15), the vector each contiguous range of lines raises. Ranges are inclusive and must not overlap. This is what lets a handler and a platform emitter learn the grouping as DATA instead of hardcoding the split; `irq` stays for the single-vector case.",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "irq",
                "first",
                "last"
              ],
              "additionalProperties": false,
              "properties": {
                "irq": {
                  "type": "string",
                  "description": "Name of an entry in the chip's `interrupts` table."
                },
                "first": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "description": "First line of the range, inclusive."
                },
                "last": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "description": "Last line of the range, inclusive."
                }
              }
            }
          },
          "port_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "This I/O port's number in its chip's port-select encoding \u2014 the value written to the pin-interrupt mux to route this port's pins (STM32 EXTI/SYSCFG EXTICR: A=0, B=1, ... F=5). It is a silicon fact, not the alphabetical position of the peripheral's name: a die that omits a port leaves a HOLE in the numbering, so it must be recorded rather than inferred."
          },
          "kernel_clock": {
            "type": "string"
          },
          "reset_clear": {
            "type": "object",
            "description": "A reset bit to CLEAR (rmw) before the block runs, when it lives in a separate readable register from the clock gate (ESP32 DPORT_PERIP_RST_EN).",
            "required": [
              "peripheral",
              "register",
              "bit"
            ],
            "additionalProperties": false,
            "properties": {
              "peripheral": {
                "type": "string"
              },
              "register": {
                "type": "string"
              },
              "bit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            }
          },
          "channels": {
            "type": "object",
            "description": "Named channels of this peripheral (ADC internal channels etc.), emitted as ch_<name> constants on the instance descriptor.",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "companions": {
            "type": "object",
            "description": "Named references to sibling peripherals a driver needs alongside this block (RP2040 io_bank0 -> {sio, pads}). Emitted as using-aliases inside the instance descriptor.",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "dma_requests": {
            "type": "object",
            "description": "DMA request/trigger IDs this peripheral drives on the chip's DMA router (ST DMAMUX request IDs, SAM XDMAC PERIDs, RP2040 DREQs). Emitted as dmareq_<name> constants on the instance descriptor.",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "dma_routes": {
            "type": "object",
            "description": "For a chip with NO DMA request router (STM32F4/F7/L4): the specific controller+channel each of this peripheral's DMA signals can be served by, and the per-channel selector value to write there. A `request` alone is not a fact on these parts — it only means anything relative to the channel it selects on, and a signal usually offers several alternative channels. Chips WITH a router use `dma_requests` instead, whose id is chip-wide.",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "controller",
                  "channel"
                ],
                "additionalProperties": false,
                "properties": {
                  "controller": {
                    "type": "string",
                    "description": "Name of the DMA controller peripheral in this chip's `peripherals`."
                  },
                  "channel": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31,
                    "description": "Channel (F4/F7 call it a stream) index on that controller, as the silicon numbers it."
                  },
                  "request": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255,
                    "description": "Value written to that channel's source selector (F4/F7 DMA_SxCR.CHSEL, L4 DMA_CSELR). Absent where the channel implies the source."
                  }
                }
              }
            }
          },
          "rmii": {
            "type": "object",
            "description": "RMII pin bank for a MAC (GMAC/EMAC): the fixed pins the block's RMII function occupies on this die and their alternate-function number. A chip fact \u2014 a board only chooses whether to wire Ethernet, not which pins the RMII function lives on.",
            "required": [
              "af",
              "pins"
            ],
            "additionalProperties": false,
            "properties": {
              "af": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "pins": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          },
          "rmii_select": {
            "type": "object",
            "description": "For a MAC whose RMII-vs-MII select lives OUTSIDE its own register block (STM32: SYSCFG_PMC, not the ETH block): the register address + bit to set for RMII, and the clock-enable to run first. A chip fact, emitted into the generated eth_configure_pins() so no silicon address sits in the hand-written HAL. MACs whose select is in-block (SAME70 GMAC's UR) omit it.",
            "required": [
              "addr",
              "bit",
              "clock"
            ],
            "additionalProperties": false,
            "properties": {
              "addr": {
                "type": "string",
                "pattern": "^0x[0-9A-Fa-f]+$"
              },
              "bit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "clock": {
                "type": "object",
                "required": [
                  "addr",
                  "bit"
                ],
                "additionalProperties": false,
                "properties": {
                  "addr": {
                    "type": "string",
                    "pattern": "^0x[0-9A-Fa-f]+$"
                  },
                  "bit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31
                  }
                }
              }
            }
          },
          "uncurated": {
            "const": true,
            "description": "Peripheral exists on the die but its IP register file is not curated yet: base/gate/irq/pin/DMA facts are recorded, codegen emits nothing for it. Builders set this; ip_hint carries the verbatim upstream tag."
          },
          "ip_hint": {
            "type": "string",
            "description": "Upstream IP identification tag (e.g. embassy 'lptim:v1'), verbatim \u2014 the ip_map key a future curation resolves."
          },
          "bases": {
            "type": "object",
            "description": "Extra address windows for a peripheral that is not one contiguous block, keyed by the window name its register file uses. `base` is the default window; each entry here is another. RL78 splits ports and the ADC across the SFR area and the 2nd SFR area ~64 KB apart.",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/hex"
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "ip"
            ]
          },
          {
            "required": [
              "uncurated",
              "ip_hint"
            ]
          }
        ]
      }
    },
    "pins": {
      "type": "object",
      "propertyNames": {
        "pattern": "^p[a-z][0-9]{1,2}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "port",
          "index"
        ],
        "additionalProperties": false,
        "properties": {
          "port": {
            "type": "string",
            "pattern": "^[a-z]$"
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "bank": {
            "type": "string",
            "description": "Explicit controlling peripheral for this pin when it is not gpio<port>/pio<port> (RP2040: io_bank0)."
          },
          "iomux": {
            "type": "object",
            "description": "Per-pin pad-control register at a NON-sequential offset (ESP32 IO_MUX): absolute address = peripheral.base + offset.",
            "required": [
              "peripheral",
              "offset"
            ],
            "additionalProperties": false,
            "properties": {
              "peripheral": {
                "type": "string"
              },
              "offset": {
                "$ref": "#/$defs/hex"
              }
            }
          },
          "mux_unlock": {
            "type": "object",
            "description": "A bit that must be SET before this pin can leave its system function (e.g. SAM E70 PB4 is JTAG TDI until MATRIX CCFG_SYSIO bit 4 is set). Resolved like a gate: peripheral.register.bit.",
            "required": [
              "peripheral",
              "register",
              "bit"
            ],
            "additionalProperties": false,
            "properties": {
              "peripheral": {
                "type": "string"
              },
              "register": {
                "type": "string"
              },
              "bit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pin",
          "peripheral",
          "signal",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "pin": {
            "type": "string"
          },
          "peripheral": {
            "type": "string"
          },
          "signal": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "af_fixed",
              "funcsel",
              "full_matrix",
              "psel"
            ]
          },
          "af": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "funcsel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "matrix_signal": {
            "type": "integer",
            "minimum": 0
          },
          "direction": {
            "enum": [
              "in",
              "out",
              "inout"
            ]
          }
        }
      }
    },
    "interrupts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "number"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "number": {
            "type": "integer",
            "minimum": 0,
            "maximum": 495
          }
        }
      }
    },
    "boot": {
      "type": "object",
      "description": "Second-stage boot payload required before application code can run (RP2040 boot2: 256 bytes at flash start, CRC32/MPEG-2 over the first 252 bytes in the last word).",
      "required": [
        "kind",
        "size",
        "payload_hex",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "rp2040_boot2"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 4
        },
        "payload_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "license": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "clock": {
      "type": "object",
      "required": [
        "sources",
        "boot_source",
        "profiles"
      ],
      "additionalProperties": false,
      "properties": {
        "boot_source": {
          "type": "string",
          "description": "The clock source the chip runs from at reset; the generated board::init() falls back to it when a clock program fails (e.g. missing crystal)."
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "hz"
            ],
            "additionalProperties": false,
            "properties": {
              "hz": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "sysclk_hz",
              "ahb_hz",
              "apb_hz",
              "program"
            ],
            "additionalProperties": false,
            "properties": {
              "sysclk_hz": {
                "type": "integer",
                "minimum": 1
              },
              "ahb_hz": {
                "type": "integer",
                "minimum": 1
              },
              "apb_hz": {
                "type": "integer",
                "minimum": 1
              },
              "apb2_hz": {
                "type": "integer",
                "minimum": 1,
                "description": "Second APB bus frequency where the chip has one (STM32 F/H APB2). Omit on single-APB chips: codegen mirrors apb_hz."
              },
              "description": {
                "type": "string"
              },
              "program": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/clock_op"
                },
                "description": "The register writes that reach this profile, in order. MAY be empty: on some parts a profile is the reset state and there is nothing to write \u2014 RL78's HOCO frequency is selected by an option byte, which is image content rather than a program. An empty list means 'already there', not 'not described yet'; the description field is where that gets said."
              }
            }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "description": "The physical part: which package this chip file describes and what sits on each pin. Optional \u2014 a chip is fully usable without it, and a pinout that fails the plausibility lint is left out rather than shipped wrong.",
      "required": [
        "type",
        "pins",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+$",
          "description": "LQFP64, UFBGA100, QFN56, \u2026"
        },
        "pins": {
          "type": "integer",
          "minimum": 8,
          "description": "pin count; must equal len(layout)"
        },
        "part": {
          "type": "string",
          "description": "the orderable part number this package belongs to (STM32G071RBTx), since one die ships in several"
        },
        "layout": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": [
              "position",
              "signal"
            ],
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "string",
                "description": "1..N for quad packages, A1/B2 for grids"
              },
              "signal": {
                "type": "string",
                "description": "pin name (pa5, vdd, nrst)"
              },
              "kind": {
                "enum": [
                  "gpio",
                  "power",
                  "ground",
                  "reset",
                  "analog",
                  "clock",
                  "boot",
                  "other"
                ]
              },
              "alt": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "other names the datasheet gives this pin"
              }
            }
          }
        }
      }
    },
    "image_config": {
      "type": "array",
      "description": "Regions the IMAGE must carry that the CPU reads at reset, before a line of code runs \u2014 RL78's option bytes and security ID, AVR's fuses. Unlike `boot`, whose payload is a fixed chip fact, the VALUES here are a board decision (watchdog on or off, brown-out level, and on RL78 the HOCO frequency the whole clock tree derives from). The chip declares the slot and what the bytes mean; the board fills it. No values belong in this file.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "base",
          "size",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "base": {
            "$ref": "#/$defs/hex"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "erased_value": {
            "$ref": "#/$defs/hex",
            "description": "What an unprogrammed byte reads as, when leaving the region blank is a legal (if rarely intended) configuration."
          }
        }
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^0x[0-9A-Fa-f]+$"
    },
    "clock_op": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "peripheral",
            "register",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "write"
            },
            "peripheral": {
              "type": "string"
            },
            "register": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/hex"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "peripheral",
            "register",
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "rmw"
            },
            "peripheral": {
              "type": "string"
            },
            "register": {
              "type": "string"
            },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "peripheral",
            "register",
            "field",
            "equals",
            "timeout_us"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "poll"
            },
            "peripheral": {
              "type": "string"
            },
            "register": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "equals": {
              "type": "integer",
              "minimum": 0
            },
            "timeout_us": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "us"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "delay"
            },
            "us": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
