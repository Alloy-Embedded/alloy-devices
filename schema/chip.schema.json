{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alloy.chip.v1",
  "title": "Alloy per-chip instance file",
  "type": "object",
  "required": ["schema", "vendor", "family", "part", "provenance", "cores", "memories", "peripherals", "interrupts", "clock"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "alloy.chip.v1" },
    "vendor": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "family": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "part": { "type": "string", "minLength": 4 },
    "die": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verified": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "arch"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "arch": { "enum": ["armv6m", "armv7m", "armv7em", "armv8m_base", "armv8m_main", "rv32imc", "rv32imac", "xtensa_lx6", "xtensa_lx7", "avr8"] },
          "fpu": { "type": "boolean", "default": false },
          "nvic_prio_bits": { "type": "integer", "minimum": 1, "maximum": 8 }
        }
      }
    },
    "memories": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "kind", "base", "size"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "kind": { "enum": ["flash", "ram", "ccm", "eeprom"] },
          "base": { "$ref": "#/$defs/hex" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "peripherals": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["ip", "base"],
        "additionalProperties": false,
        "properties": {
          "ip": { "type": "string", "pattern": "^[a-z0-9_]+/[a-z0-9_]+$" },
          "base": { "$ref": "#/$defs/hex" },
          "gate": {
            "type": "object",
            "required": ["peripheral", "register", "bit"],
            "additionalProperties": false,
            "properties": {
              "peripheral": { "type": "string" },
              "register": { "type": "string" },
              "bit": { "type": "integer", "minimum": 0, "maximum": 31 },
              "style": {
                "enum": ["rmw", "write_set"],
                "default": "rmw",
                "description": "rmw: set the bit read-modify-write (ST *ENR). write_set: the register is a write-only set register — write the mask directly (Microchip PMC_PCERx)."
              }
            }
          },
          "irq": { "type": "string" },
          "kernel_clock": { "type": "string" }
        }
      }
    },
    "pins": {
      "type": "object",
      "propertyNames": { "pattern": "^p[a-z][0-9]{1,2}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["port", "index"],
        "additionalProperties": false,
        "properties": {
          "port": { "type": "string", "pattern": "^[a-z]$" },
          "index": { "type": "integer", "minimum": 0, "maximum": 31 }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pin", "peripheral", "signal", "kind"],
        "additionalProperties": false,
        "properties": {
          "pin": { "type": "string" },
          "peripheral": { "type": "string" },
          "signal": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "kind": { "enum": ["af_fixed", "funcsel", "full_matrix", "psel"] },
          "af": { "type": "integer", "minimum": 0, "maximum": 15 },
          "funcsel": { "type": "integer", "minimum": 0, "maximum": 31 },
          "matrix_signal": { "type": "integer", "minimum": 0 },
          "direction": { "enum": ["in", "out", "inout"] }
        }
      }
    },
    "interrupts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "number"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "number": { "type": "integer", "minimum": 0, "maximum": 495 }
        }
      }
    },
    "clock": {
      "type": "object",
      "required": ["sources", "boot_source", "profiles"],
      "additionalProperties": false,
      "properties": {
        "boot_source": {
          "type": "string",
          "description": "The clock source the chip runs from at reset; the generated board::init() falls back to it when a clock program fails (e.g. missing crystal)."
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": {
            "type": "object",
            "required": ["hz"],
            "additionalProperties": false,
            "properties": { "hz": { "type": "integer", "minimum": 1 } }
          }
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": {
            "type": "object",
            "required": ["sysclk_hz", "ahb_hz", "apb_hz", "program"],
            "additionalProperties": false,
            "properties": {
              "sysclk_hz": { "type": "integer", "minimum": 1 },
              "ahb_hz": { "type": "integer", "minimum": 1 },
              "apb_hz": { "type": "integer", "minimum": 1 },
              "description": { "type": "string" },
              "program": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/clock_op" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
    "clock_op": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "peripheral", "register", "value"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "write" },
            "peripheral": { "type": "string" },
            "register": { "type": "string" },
            "value": { "$ref": "#/$defs/hex" }
          }
        },
        {
          "type": "object",
          "required": ["op", "peripheral", "register", "fields"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "rmw" },
            "peripheral": { "type": "string" },
            "register": { "type": "string" },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          }
        },
        {
          "type": "object",
          "required": ["op", "peripheral", "register", "field", "equals", "timeout_us"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "poll" },
            "peripheral": { "type": "string" },
            "register": { "type": "string" },
            "field": { "type": "string" },
            "equals": { "type": "integer", "minimum": 0 },
            "timeout_us": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op", "us"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "delay" },
            "us": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
